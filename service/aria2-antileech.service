[Unit]
Description=aria2 anti-leech (peer-id based ipset blocker)
Documentation=https://github.com/Niter8263/aria2
After=aria2.service network-online.target
Wants=network-online.target

[Service]
Type=simple
# 脚本和配置与 aria2 放在同一目录（/root/.aria2c）
EnvironmentFile=-/root/.aria2c/antileech.conf
ExecStart=/root/.aria2c/antileech.sh
Restart=always
RestartSec=5
# 需要 root 操作 ipset / iptables
User=root

[Install]
WantedBy=multi-user.target
